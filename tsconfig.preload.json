{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "outDir": "dist/main",
    "baseUrl": ".",
    "types": ["node"],
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/main/preload.ts"],
  "exclude": ["node_modules", "dist"]
}