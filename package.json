{
  "name": "hawthorn-offer-frontend",
  "version": "1.0.0",
  "description": "基于 Electron + Vue3 的多功能工作台前端应用",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:preload && npm run build:main",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "electron": "^42.2.0",
    "lucide-vue-next": "^0.290.0",
    "mammoth": "^1.12.0",
    "pinia": "^2.1.0",
    "pinyin-pro": "^3.28.1",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.2"
  },
  "build": {
    "appId": "com.example.hawthorn-offer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ]
  },
  "type": "module"
}