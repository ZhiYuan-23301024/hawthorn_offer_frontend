    stages {
        stage('0. 清理工作区') {
            steps {
                cleanWs()
            }
        }

        stage('1. 拉取代码') {
            steps {
                sh '''
                    eval $(ssh-agent)

                    echo "$SSH_PRIVATE_KEY" \
                    | ssh-add -

                    GIT_SSH_COMMAND="ssh \
                      -o StrictHostKeyChecking=no \
                      -o UserKnownHostsFile=/dev/null"

                    git clone \
                      ssh://${GERRIT_USER}@${GERRIT_HOST}:${GERRIT_PORT}/${REPO_URL} .

                    git fetch origin ${GERRIT_REFSPEC}
                    git checkout FETCH_HEAD
                '''
            }
        }

        stage('2. 安装依赖') {
            steps {
                sh 'npm ci'
            }
        }

        stage('3. 代码规范检查') {
            steps {
                sh 'npm run lint'
            }
        }

        stage('4. TypeScript 编译 + Vite 构建') {
            steps {
                sh 'npm run build'
            }
        }

        stage('5. 检查完成') {
            steps {
                echo '所有检查通过，等待 Gerrit Trigger 评分...'
            }
        }
    }

    post {
        success {
            sh '''
              ssh -p 29418 jenkins@gerrit.lilingkun.com \
                gerrit review ${GERRIT_CHANGE_NUMBER},${GERRIT_PATCHSET_NUMBER} \
                --label Verified=1
            '''
        }
        failure {
            sh '''
              ssh -p 29418 jenkins@gerrit.lilingkun.com \
                gerrit review ${GERRIT_CHANGE_NUMBER},${GERRIT_PATCHSET_NUMBER} \
                --label Verified=-1
            '''
        }
    }
}